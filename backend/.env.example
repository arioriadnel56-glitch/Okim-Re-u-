PORT=4000
JWT_SECRET=remplacez-moi-par-une-chaine-aleatoire-longue
APP_PUBLIC_URL=http://localhost:5173

# Base de données PostgreSQL (obligatoire)
# En local : installez PostgreSQL puis créez une base, ex. postgresql://okimart:motdepasse@localhost:5432/okimart
# Sur Render : utilisez l'URL "Internal Database URL" fournie par votre instance Render Postgres.
DATABASE_URL=postgresql://okimart:motdepasse@localhost:5432/okimart
# Mettez PGSSL=false en local (pas de SSL), PGSSL=true est appliqué automatiquement pour toute
# connexion qui n'est pas sur localhost (ex. Render), inutile de le forcer en production.
PGSSL=false

SEED_ADMIN_PHONE=0198874300
SEED_ADMIN_PASSWORD=okimart2026

# Envoi des reçus par email (laissez vide pour désactiver la fonctionnalité)
# Exemple avec Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=votre-adresse@gmail.com, SMTP_PASS=mot de passe d'application (pas votre mdp Gmail normal)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OKIM'ART <no-reply@okimart.studio>"
